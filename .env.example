APP_NAME=AgroMet Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_PATH=./agromet.db
# Leave unset for local dev -- SQLite at DATABASE_PATH is a fine default on
# a machine with a real filesystem. It is NOT a fine default in production:
# a `postgresql://...` connection string here is required on Vercel, whose
# filesystem resets on every cold start. Use the *pooled* connection string
# your provider (Neon, Supabase, Vercel Postgres) publishes, not the direct
# one -- a serverless function can run many concurrent instances at once.
DATABASE_URL=
# Tuned for a free-tier Postgres plan's connection ceiling shared across
# every warm serverless instance. Raise DATABASE_POOL_MAX only after
# checking what your plan actually allows.
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Speech to text for the composer mic. Used by /api/transcribe.
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Ceilings on one answer. These bound what a single question can cost.
OPENAI_MAX_OUTPUT_TOKENS=400
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT_SECONDS=20
# The chat quota, per device and (ten times over) per address.
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=900
CHAT_DAILY_LIMIT=120
# Set to true only on a developer machine. It makes the values in this
# file load as real configuration, which on a server would quietly hand a
# live process SECRET_KEY=change-me-for-production and DEBUG=true.
USE_EXAMPLE_ENV=false
LOG_LEVEL=INFO
KINDWISE_API_KEY=
KINDWISE_CROP_HEALTH_API_KEY=...
KINDWISE_PLANT_ID_API_KEY=...
KINDWISE_CROP_HEALTH_URL=https://crop.kindwise.com
KINDWISE_PLANT_ID_URL=https://api.plant.id/v3
GHANANLP_PRIMARY_KEY=
GHANANLP_SECONDARY_KEY=
GHANANLP_TRANSLATE_URL=https://translation-api.ghananlp.org/v1
GHANANLP_TTS_URL=https://translation-api.ghananlp.org/tts/v1
AMBEE_API_KEY=
AMBEE_BASE_URL=https://api.ambeedata.com
HUGGINGFACE_API_TOKEN=
